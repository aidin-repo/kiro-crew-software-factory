ca;" connectable="0" vertex="1" parent="e10"><mxGeometry relative="1" x="0" as="geometry"><mxPoint y="16" as="offset"/></mxGeometry></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1A9C37;strokeWidth=2;rounded=1;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="approver" target="github"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="640"/><mxPoint x="340" y="640"/></Array></mxGeometry></mxCell><mxCell id="e11-label" value="kiro-approved-to-merge · you read the DECISION and merge" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e11"><mxGeometry relative="1" x="0.3" as="geometry"><mxPoint y="-16" as="offset"/></mxGeometry></mxCell><mxCell id="escalations" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#DD344C;fontFamily=Helvetica;" value="Escalations to you, by label: kiro-needs-owner (planner, approver), kiro-parked (gate). Nothing merges on its own unless you enable KIRO_APPROVER_MERGE." vertex="1" parent="1"><mxGeometry x="560" y="672" width="1200" height="20" as="geometry"/></mxCell><mxCell id="step-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="1" vertex="1" parent="1"><mxGeometry x="210" y="258" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="2" vertex="1" parent="1"><mxGeometry x="440" y="258" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="3" vertex="1" parent="1"><mxGeometry x="740" y="258" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="4" vertex="1" parent="1"><mxGeometry x="952" y="372" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="5" vertex="1" parent="1"><mxGeometry x="745" y="468" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="6" vertex="1" parent="1"><mxGeometry x="1315" y="468" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="7" vertex="1" parent="1"><mxGeometry x="1505" y="468" width="28" height="28" as="geometry"/></mxCell><mxCell id="legend-bg" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" value="" vertex="1" parent="1"><mxGeometry height="720" width="560" x="1790" y="30" as="geometry"/></mxCell><mxCell id="legend-container" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="1"><mxGeometry height="680" width="520" x="1810" y="50" as="geometry"/></mxCell><mxCell id="legend-title" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;" value="How a label becomes a pull request" vertex="1" parent="legend-container"><mxGeometry x="0" y="0" width="500" height="24" as="geometry"/></mxCell><mxCell id="step-1-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="70" width="520" x="0" y="50" as="geometry"/></mxCell><mxCell id="step-1-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="step-1-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-1-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Write an issue, add one label&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Only a label applied by the repository owner, on an issue the owner wrote, starts anything. Collaborators' labels are ignored. Private repositories only.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-1-legend"><mxGeometry height="70" width="468" x="52" as="geometry"/></mxCell><mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="60" width="520" x="0" y="130" as="geometry"/></mxCell><mxCell id="step-2-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="step-2-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-2-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Every label is a GitHub Actions event&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow job runs on your self-hosted runner. It checks out the default branch only, never pull-request code.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-2-legend"><mxGeometry height="60" width="468" x="52" as="geometry"/></mxCell><mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="90" width="520" x="0" y="200" as="geometry"/></mxCell><mxCell id="step-3-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="step-3-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-3-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The dispatcher re-validates and signs&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;dispatch_kiro_event.py re-checks owner, branch and PR state, strips hidden text, base64-wraps the issue as untrusted data, HMAC-signs the body and POSTs it to the loopback gateway. Non-loopback URLs are refused.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-3-legend"><mxGeometry height="90" width="468" x="52" as="geometry"/></mxCell><mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="520" x="0" y="300" as="geometry"/></mxCell><mxCell id="step-4-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="step-4-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-4-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The gateway starts the agent for that label&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Each role is its own webhook source bound to its own template, so a stage cannot borrow another's permissions. Runs are unattended: only tool calls matching your auto-approve rules execute.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-4-legend"><mxGeometry height="80" width="468" x="52" as="geometry"/></mxCell><mxCell id="step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="90" width="520" x="0" y="390" as="geometry"/></mxCell><mxCell id="step-5-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="step-5-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-5-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Planner → implementer → reviewer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The planner (Opus) posts an AIDLC spec with a files block. The implementer (Opus) builds in a fresh worktree and opens the PR with the spec URL and SHA-256. The reviewer (Sonnet) posts a VERDICT; fixes loop at most 3 times.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-5-legend"><mxGeometry height="90" width="468" x="52" as="geometry"/></mxCell><mxCell id="step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="90" width="520" x="0" y="490" as="geometry"/></mxCell><mxCell id="step-6-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="step-6-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-6-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Gate, then approver&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;kiro_gate.py has no model: head SHA reviewed, CI green, changed files inside the spec block, spec hash matches. On PASS the same job dispatches the approver (Opus), which reads spec, review, gate comment and diff through gh and posts a DECISION.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-6-legend"><mxGeometry height="90" width="468" x="52" as="geometry"/></mxCell><mxCell id="step-7-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="520" x="0" y="590" as="geometry"/></mxCell><mxCell id="step-7-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="step-7-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-7-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;You merge, the scribe documents&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;kiro-approved-to-merge is the pipeline's last word; you merge. The scribe (Sonnet) then opens a docs-only PR. kiro-needs-owner and kiro-parked hand the decision back to you.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-7-legend"><mxGeometry height="80" width="468" x="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>