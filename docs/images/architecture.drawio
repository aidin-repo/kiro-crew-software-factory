;entryDx=0;entryDy=0;" edge="1" parent="1" source="planner" target="implementer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5-label" value="kiro-approved" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e5"><mxGeometry relative="1" x="0" as="geometry"><mxPoint y="16" as="offset"/></mxGeometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#545B64;strokeWidth=2;rounded=1;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="implementer" target="reviewer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6-label" value="PR · kiro-review" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e6"><mxGeometry relative="1" x="0" as="geometry"><mxPoint y="16" as="offset"/></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#ED7100;strokeWidth=2;rounded=1;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0.999;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="reviewer" target="implementer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="600"/><mxPoint x="850" y="600"/></Array></mxGeometry></mxCell><mxCell id="e7-label" value="kiro-changes-requested, at most 3 rounds" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e7"><mxGeometry relative="1" x="0" as="geometry"><mxPoint y="16" as="offset"/></mxGe