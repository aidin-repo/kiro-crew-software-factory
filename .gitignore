# Your own prompts and roles; install-agent.sh prefers these over templates/agent/
templates/agent.local/

# Local tool and IDE files. The steering file for Kiro is tracked; the rest of .kiro/ is not.
.env.omni
.omni/
.kiro/*
!.kiro/steering/
.claude/
.cursor/
.agents/

# Python caches from running the tests
__pycache__/
.pytest_cache/
.venv/

# OS files
.DS_Store
